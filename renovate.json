{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "dependencyDashboard": {
    "enabled": true
  },
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "platformAutomerge": true,
  "automergeType": "branch",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "description": "Renovate only bumps the direct dependencies in pyproject.toml. Refreshing poetry.lock weekly keeps the transitive ones (urllib3, certifi, lxml, ...) current as well",
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Poetry that the Docker build stage installs to resolve and export the dependencies",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ENV POETRY_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "poetry",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "The Poetry export plugin that the Docker build stage uses to write requirements.txt",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "poetry-plugin-export==(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "poetry-plugin-export",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Safely automerge patch and digest updates",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Python runtime/dev dependencies from pyproject",
      "matchManagers": [
        "pep621",
        "poetry"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python-dependencies",
      "automerge": true
    },
    {
      "description": "Poetry tooling in the Docker build stage",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "poetry",
      "automerge": true
    },
    {
      "description": "Docker base images (Python runtime)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "docker-base-images",
      "automerge": true
    },
    {
      "description": "GitHub Actions workflow dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions",
      "automerge": true
    }
  ]
}
